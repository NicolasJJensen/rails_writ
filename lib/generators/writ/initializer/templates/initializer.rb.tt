# frozen_string_literal: true

Writ.configure do |config|
<%- if multi_tenant? -%>
  config.scoping_model = <%= scoping_model_name.inspect %>
  config.tenant_source = ->(context) { Current.<%= scoping_association %> }
<%- end -%>
<%- %w[Role Permission Scope PermissionScope Condition PermissionCondition].each do |name| -%>
  config.<%= name.underscore %>_class = <%= model_class_name(name).inspect %>
<%- end -%>

  # Missing field declarations allow all fields. Use [] for explicit opt-in.
  # config.field_default = []

  # These checks raise by default. :deny excludes only the invalid grant.
  # config.on_missing_condition = :raise
  # config.on_condition_error = :raise
  # config.on_invalid_scope_arguments = :raise
  # config.on_invalid_condition_arguments = :raise

  # Keep missing boundaries and proposed-state matchers visible as errors.
  # config.on_missing_default_scope = :raise
  # config.on_missing_matcher = :raise
<%- if multi_tenant? -%>

  # Writ selects the current tenant's roles from the actor's assigned roles.
  # Default roles are generated for new tenants, but user assignment is explicit.
  # config.default_role_name = 'Member'
<%- end -%>
end
