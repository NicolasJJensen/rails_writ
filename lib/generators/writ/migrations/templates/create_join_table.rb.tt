class CreateJoinTable<%= model_table_name('Role').camelize %><%= roleable_model_name.delete(':').pluralize %> < ActiveRecord::Migration<%= migration_version %>
  def change
    create_table :<%= membership_table_name %>, id: false do |t|
      t.references :role, null: false, index: false, foreign_key: { to_table: :<%= model_table_name('Role') %> }
      t.<%= roleable_primary_key_type %> :<%= roleable_foreign_key %>, null: false
      t.index [:<%= roleable_foreign_key %>, :role_id], unique: true, name: <%= index_name(membership_table_name, 'actor_role').inspect %>
      t.index [:role_id, :<%= roleable_foreign_key %>], name: <%= index_name(membership_table_name, 'role_actor').inspect %>
    end

    add_foreign_key :<%= membership_table_name %>, :<%= roleable_table_name %>,
                    column: :<%= roleable_foreign_key %>, primary_key: <%= roleable_primary_key.inspect %>
  end
end
